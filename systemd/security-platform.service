[Unit]
Description=WHM Security Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/security-platform
Environment=SECURITY_PLATFORM_CONFIG=/etc/security-platform/config.yml
ExecStart=/opt/security-platform/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8443
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/var/lib/security-platform /var/log/security-platform /etc/security-platform
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
